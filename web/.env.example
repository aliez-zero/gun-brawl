# Copy to .env.local and restart pnpm dev / pnpm preview.
# Server only. Do not use a VITE_ prefix for this key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_REQUESTS=180
DEEPSEEK_INTERVAL_MS=500
DEEPSEEK_TIMEOUT_MS=10000
# Per-request context budget (input + reserved output), hard maximum 512K tokens.
DEEPSEEK_CONTEXT_TOKENS=512000
# Thinking mode lets the model evaluate survival, route and attack priorities before returning JSON.
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=low
