{
  "name": "gun-brawl",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/smoke.mjs",
    "test:perf": "node scripts/perf.mjs",
    "test:latency": "node scripts/latency.mjs",
    "test:visual": "node scripts/appearance-maps.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
