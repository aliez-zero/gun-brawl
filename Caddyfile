{$DOMAIN} {
	encode zstd gzip

	# DeepSeek gateway sidecar keeps the API key and budget server-side.
	handle /api/deepseek/* {
		reverse_proxy gateway:8090
	}

	reverse_proxy app:8080

	header {
		# No includeSubDomains: other subdomains on this domain may still be plain HTTP,
		# and a cached HSTS rule would lock browsers out of them.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
