# Deployment environment (docker compose). Never commit the real .env.
DOMAIN=play.example.com
IMAGE_PREFIX=ghcr.io/owner/gun-brawl
TAG=latest
GUNBRAWL_DB=/data/gunbrawl.db

# Optional: DeepSeek opponent. Leave empty to hide the mode in production.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_REQUESTS=180
DEEPSEEK_INTERVAL_MS=500
DEEPSEEK_TIMEOUT_MS=5000
DEEPSEEK_CONTEXT_TOKENS=512000
DEEPSEEK_THINKING=enabled
DEEPSEEK_REASONING_EFFORT=low
